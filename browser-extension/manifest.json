{
  "manifest_version": 3,
  "name": "Interview OS Job Sync",
  "version": "0.3.5",
  "description": "将已打开招聘页面中的可见岗位只读同步到本机 Interview OS。",
  "permissions": ["storage", "tabs", "alarms", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1:19426/*",
    "https://www.zhipin.com/*",
    "https://www.liepin.com/*",
    "https://www.zhaopin.com/*",
    "https://i.zhaopin.com/*",
    "https://jobs.zhaopin.com/*",
    "https://we.51job.com/*",
    "https://www.51job.com/*",
    "https://jobs.51job.com/*",
    "https://i.51job.com/*",
    "https://www.lagou.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Interview OS Job Sync" },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://www.liepin.com/*",
        "https://www.zhaopin.com/*",
        "https://i.zhaopin.com/*",
        "https://jobs.zhaopin.com/*",
        "https://we.51job.com/*",
        "https://www.51job.com/*",
        "https://jobs.51job.com/*",
        "https://i.51job.com/*",
        "https://www.lagou.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
